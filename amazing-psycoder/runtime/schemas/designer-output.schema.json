{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psycoder.studio/schemas/designer-output.schema.json",
  "title": "PsyCoder DesignerModelOutput",
  "type": "object",
  "required": [
    "assistantMessage",
    "questions",
    "decisions",
    "missingFields",
    "commands",
    "proposalSummary",
    "warnings"
  ],
  "properties": {
    "assistantMessage": { "type": "string", "minLength": 1, "maxLength": 12000 },
    "questions": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "maxLength": 2000 }
    },
    "decisions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["path", "label", "value", "source", "status"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 300 },
          "label": { "type": "string", "minLength": 1, "maxLength": 300 },
          "value": {},
          "source": { "enum": ["user", "agent", "system"] },
          "status": { "enum": ["proposed", "confirmed", "assumed", "missing"] }
        },
        "additionalProperties": false
      }
    },
    "missingFields": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "maxLength": 300 }
    },
    "commands": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "type",
          "baseModelRevision",
          "scope",
          "modelPaths",
          "beforeAfterSummary",
          "destructive",
          "confirmationLevel",
          "payload"
        ],
        "properties": {
          "type": {
            "enum": [
              "update_experiment_meta",
              "add_sequence",
              "update_sequence",
              "remove_sequence",
              "reorder_sequences",
              "add_window",
              "update_window",
              "remove_window",
              "reorder_windows",
              "move_window_to_sequence",
              "add_scene_element",
              "update_scene_element",
              "remove_scene_element",
              "reorder_scene_elements",
              "update_window_timing",
              "update_window_response",
              "update_window_data",
              "import_condition_table",
              "create_condition_table",
              "bind_condition_table",
              "unbind_condition_table",
              "set_platform",
              "update_display_contract",
              "update_data_contract",
              "update_runtime_contract",
              "upsert_advanced_logic",
              "remove_advanced_logic"
            ]
          },
          "baseModelRevision": { "type": "string", "minLength": 1, "maxLength": 200 },
          "scope": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["experiment", "sequence", "window"] },
              "sequenceId": { "type": "string", "minLength": 1, "maxLength": 200 },
              "windowId": { "type": "string", "minLength": 1, "maxLength": 200 }
            },
            "additionalProperties": false
          },
          "modelPaths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^/", "maxLength": 1000 }
          },
          "beforeAfterSummary": {
            "type": "object",
            "required": ["before", "after"],
            "properties": {
              "before": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "after": { "type": "string", "minLength": 1, "maxLength": 2000 }
            },
            "additionalProperties": false
          },
          "destructive": { "type": "boolean" },
          "confirmationLevel": { "enum": ["proposal", "explicit_user_confirmation"] },
          "payload": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "proposalSummary": { "type": "string", "maxLength": 2000 },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 2000 }
    }
  },
  "additionalProperties": false
}
