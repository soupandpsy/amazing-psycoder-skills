{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psycoder.studio/schemas/runtime-evidence.schema.json",
  "title": "PsyCoder Target-Machine Runtime Evidence",
  "type": "object",
  "required": [
    "evidence_id",
    "artifact_set_hash",
    "target",
    "tests",
    "started_at",
    "completed_at",
    "recorded_by",
    "verification"
  ],
  "properties": {
    "evidence_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "artifact_set_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target": {
      "type": "object",
      "required": ["platform", "os", "runtime_version", "hardware"],
      "properties": {
        "platform": { "enum": ["psychopy", "jspsych", "psychtoolbox"] },
        "os": { "type": "string", "minLength": 1, "maxLength": 500 },
        "runtime_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "hardware": { "type": "string", "minLength": 1, "maxLength": 2000 }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "allOf": [
        {
          "contains": {
            "properties": { "id": { "const": "launch_exit" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "id": { "const": "full_short_session" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "id": { "const": "data_integrity" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "id": { "const": "incremental_recovery" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "id": { "const": "timing_device_check" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "required": ["id", "result", "procedure", "evidence_paths"],
        "properties": {
          "id": {
            "enum": [
              "launch_exit",
              "full_short_session",
              "data_integrity",
              "incremental_recovery",
              "timing_device_check"
            ]
          },
          "result": { "enum": ["passed", "failed", "blocked"] },
          "procedure": { "type": "string", "minLength": 1, "maxLength": 12000 },
          "evidence_paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
          },
          "notes": { "type": "string", "maxLength": 12000 }
        },
        "additionalProperties": false
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "recorded_by": { "type": "string", "minLength": 1, "maxLength": 500 },
    "verification": {
      "type": "object",
      "required": ["level", "verified_by", "verified_at", "file_digests"],
      "properties": {
        "level": {
          "enum": ["user_attested", "machine_verified", "reviewer_verified"]
        },
        "verified_by": { "type": "string", "minLength": 1, "maxLength": 500 },
        "verified_at": { "type": "string", "format": "date-time" },
        "file_digests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {
            "type": "object",
            "required": ["path", "sha256", "size_bytes"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2097152
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
