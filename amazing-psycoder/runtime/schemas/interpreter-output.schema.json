{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psycoder.studio/schemas/interpreter-output.schema.json",
  "title": "PsyCoder Immutable-Spec Interpretation",
  "type": "object",
  "required": ["executionPlanHash", "interpretations", "warnings"],
  "properties": {
    "executionPlanHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "interpretations": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["path", "meaning", "source"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 500 },
          "meaning": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "source": { "const": "confirmed_spec" }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    }
  },
  "additionalProperties": false
}
