{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psycoder.studio/schemas/artifact-output.schema.json",
  "title": "PsyCoder Model-Owned Runtime Artifact Output",
  "description": "Current v1.4 internal contract for AI inspection output over compiler-authored runtime files. The Worker validates the frozen ExperimentModel@4 and asset-set binding plus the exact platform path allowlist. Initial generation output remains compiler-identical; changed source is accepted only by the separate repair-attempt path after runtime-kernel proof, evidence rebinding, deterministic validation, and independent rereview.",
  "type": "object",
  "required": ["platform", "modelHash", "assetSetHash", "files", "warnings", "assumptions"],
  "properties": {
    "platform": { "enum": ["psychopy", "jspsych", "psychtoolbox"] },
    "modelHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assetSetHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/file" }
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?!/)(?!_pipeline(?:/|$))(?!\\.\\.?(/|$))(?!.*(?:/)\\.\\.?(?:/|$))(?!.*\\\\)[A-Za-z0-9._ -]+(?:/[A-Za-z0-9._ -]+)*$"
    },
    "file": {
      "type": "object",
      "required": ["path", "content", "mediaType", "ownership"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "content": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 200 },
        "language": { "type": ["string", "null"], "maxLength": 100 },
        "ownership": { "const": "model" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
