{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psycoder.studio/schemas/generation-input.schema.json",
  "title": "PsyCoder Studio Generation Envelope 2.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectName",
    "target",
    "experimentSpec",
    "executionPlan",
    "executionPlanHash",
    "validationSummary",
    "aiMode",
    "requestedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "projectName": { "type": "string", "minLength": 1, "maxLength": 100 },
    "target": {
      "type": "object",
      "required": ["platform"],
      "properties": {
        "platform": { "enum": ["psychopy", "jspsych", "psychtoolbox"] }
      },
      "additionalProperties": false
    },
    "experimentSpec": {
      "type": "object",
      "required": [
        "schemaVersion",
        "meta",
        "flow",
        "trialRoutines",
        "windows",
        "conditions",
        "responses",
        "dataSchema",
        "builderState",
        "designLifecycle"
      ],
      "properties": {
        "schemaVersion": { "const": "2.4" },
        "meta": { "type": "object" },
        "flow": { "type": "array", "minItems": 1 },
        "trialRoutines": { "type": "array", "minItems": 1 },
        "windows": { "type": "array", "minItems": 1 },
        "conditions": { "type": "object" },
        "responses": { "type": "object" },
        "dataSchema": { "type": "array", "minItems": 1 },
        "assets": { "type": "array" },
        "builderState": { "type": "object" },
        "designLifecycle": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "const": "confirmed" },
            "confirmedAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "executionPlan": { "$ref": "execution-plan.schema.json" },
    "executionPlanHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "validationSummary": {
      "type": "object",
      "required": ["valid", "errorCount", "warningCount", "infoCount", "totalIssues", "topIssueCodes"],
      "properties": {
        "valid": { "const": true },
        "errorCount": { "const": 0 },
        "warningCount": { "type": "integer", "minimum": 0 },
        "infoCount": { "type": "integer", "minimum": 0 },
        "totalIssues": { "type": "integer", "minimum": 0 },
        "topIssueCodes": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      },
      "additionalProperties": false
    },
    "aiMode": {
      "enum": ["authenticated", "platform_credit", "user_api_key"]
    },
    "requestedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
