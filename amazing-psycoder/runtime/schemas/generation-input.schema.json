{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psycoder.studio/schemas/generation-input.schema.json",
  "title": "PsyCoder Studio Generation Envelope 4.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "jobSchemaVersion",
    "projectName",
    "target",
    "experimentModel",
    "modelHash",
    "assetSetHash",
    "assetManifest",
    "compilerVersion",
    "exportRequest",
    "validationSummary",
    "aiMode",
    "requestedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "4.0" },
    "jobSchemaVersion": { "const": "2.0" },
    "projectName": { "type": "string", "minLength": 1, "maxLength": 100 },
    "target": {
      "type": "object",
      "required": ["platform"],
      "properties": {
        "platform": { "enum": ["psychopy", "jspsych", "psychtoolbox"] }
      },
      "additionalProperties": false
    },
    "experimentModel": { "$ref": "experiment-model.schema.json" },
    "modelHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assetSetHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assetManifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "sha256", "sizeBytes", "mediaType"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "path": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "mediaType": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "additionalProperties": false
      }
    },
    "compilerVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "exportRequest": { "type": "object" },
    "validationSummary": {
      "type": "object",
      "required": ["valid", "errorCount", "warningCount", "infoCount", "totalIssues", "topIssueCodes"],
      "properties": {
        "valid": { "const": true },
        "errorCount": { "const": 0 },
        "warningCount": { "type": "integer", "minimum": 0 },
        "infoCount": { "type": "integer", "minimum": 0 },
        "totalIssues": { "type": "integer", "minimum": 0 },
        "topIssueCodes": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      },
      "additionalProperties": false
    },
    "aiMode": {
      "const": "authenticated"
    },
    "requestedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
