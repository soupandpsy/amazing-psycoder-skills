{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psycoder.studio/schemas/execution-plan.schema.json",
  "title": "PsyCoder ExecutionPlan 2.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectName",
    "project",
    "target",
    "generationProfile",
    "sequences",
    "windows",
    "trialSource",
    "conditions",
    "responses",
    "dataSchema",
    "assets",
    "itiMs"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "projectName": { "type": "string", "minLength": 1, "maxLength": 100 },
    "project": {
      "type": "object",
      "required": ["id", "name", "paradigm", "paradigmFamily", "variant"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "paradigm": { "type": "string", "minLength": 1, "maxLength": 200 },
        "paradigmFamily": { "type": ["string", "null"], "maxLength": 200 },
        "variant": { "type": ["string", "null"], "maxLength": 200 }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["platform"],
      "properties": {
        "platform": { "enum": ["psychopy", "jspsych", "psychtoolbox"] }
      },
      "additionalProperties": false
    },
    "generationProfile": { "type": ["string", "null"], "maxLength": 200 },
    "sequences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/sequence" }
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/window" }
    },
    "trialSource": { "$ref": "#/$defs/trialSource" },
    "conditions": { "$ref": "#/$defs/conditions" },
    "responses": { "$ref": "#/$defs/responseRule" },
    "dataSchema": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/dataField" }
    },
    "assets": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/asset" }
    },
    "itiMs": { "type": "number", "minimum": 0, "maximum": 3600000 }
  },
  "$defs": {
    "sequence": {
      "type": "object",
      "required": ["id", "name", "order", "windowIds", "execution"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "order": { "type": "integer", "minimum": 1 },
        "windowIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "execution": {
          "oneOf": [
            {
              "type": "object",
              "required": ["mode"],
              "properties": { "mode": { "const": "once" } },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["mode", "repetitions", "shuffle"],
              "properties": {
                "mode": { "const": "loop" },
                "repetitions": { "type": "integer", "minimum": 1, "maximum": 100000 },
                "shuffle": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "required": ["id", "label", "order", "durationMs", "timing", "data"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "order": { "type": "integer", "minimum": 1 },
        "durationMs": { "type": "number", "minimum": 0, "maximum": 3600000 },
        "stimulus": {
          "type": "object",
          "required": ["type", "displayMode"],
          "properties": {
            "type": { "enum": ["text", "image", "sound", "custom"] },
            "displayMode": { "enum": ["text", "trial_field", "image", "blank"] },
            "source": { "type": "string", "maxLength": 2000 },
            "textField": { "type": "string", "maxLength": 200 },
            "colorField": { "type": "string", "maxLength": 200 },
            "staticText": { "type": "string", "maxLength": 20000 },
            "position": {
              "type": "array",
              "prefixItems": [{ "type": "number" }, { "type": "number" }],
              "minItems": 2,
              "maxItems": 2
            },
            "size": { "type": "number", "exclusiveMinimum": 0 },
            "align": { "enum": ["center", "left", "right"] }
          },
          "additionalProperties": false
        },
        "response": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "allowedKeys": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 64 }
            },
            "event": {
              "enum": ["key_down", "key_release", "click", "submit", "touch", "voice", "gaze_event", "custom"]
            },
            "correctKeyMode": { "enum": ["none", "fixed", "trial_field"] },
            "correctKey": { "type": "string", "maxLength": 100 },
            "correctKeySource": { "type": "string", "maxLength": 200 },
            "rtOnset": { "type": "string", "minLength": 1, "maxLength": 200 },
            "recordRt": { "type": "boolean" },
            "recordAccuracy": { "type": "boolean" }
          },
          "allOf": [
            {
              "if": {
                "required": ["enabled"],
                "properties": { "enabled": { "const": true } }
              },
              "then": {
                "required": ["allowedKeys", "event", "rtOnset", "recordRt", "recordAccuracy"]
              }
            }
          ],
          "additionalProperties": false
        },
        "feedback": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "correctText": { "type": "string", "maxLength": 10000 },
            "incorrectText": { "type": "string", "maxLength": 10000 },
            "timeoutText": { "type": "string", "maxLength": 10000 },
            "durationMs": { "type": "number", "minimum": 0, "maximum": 3600000 }
          },
          "additionalProperties": false
        },
        "timing": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["fixed", "until_response", "manual_continue", "trial_field"] },
            "durationField": { "type": "string", "maxLength": 200 },
            "continueKeys": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 64 }
            }
          },
          "additionalProperties": false
        },
        "data": {
          "type": "object",
          "required": ["recordResponse", "recordRt", "recordAccuracy", "recordOnset", "recordTrialFields"],
          "properties": {
            "recordResponse": { "type": "boolean" },
            "recordRt": { "type": "boolean" },
            "recordAccuracy": { "type": "boolean" },
            "recordOnset": { "type": "boolean" },
            "recordTrialFields": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "notes": { "type": "string", "maxLength": 20000 }
      },
      "additionalProperties": false
    },
    "trialSource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "factors", "randomization"],
          "properties": {
            "mode": { "const": "generated" },
            "factors": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "required": ["name", "levels"],
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "levels": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "uniqueItems": true,
                    "items": { "type": ["string", "number", "boolean"] }
                  },
                  "balance": { "const": "equal" }
                },
                "additionalProperties": false
              }
            },
            "randomization": {
              "type": "object",
              "required": ["seed"],
              "properties": {
                "seed": { "type": "string", "minLength": 1, "maxLength": 200 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "fileName", "fileType", "columns", "columnMapping"],
          "properties": {
            "mode": { "const": "table" },
            "fileName": { "$ref": "#/$defs/safePath" },
            "fileType": { "enum": ["csv", "xlsx"] },
            "columns": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 200 }
            },
            "columnMapping": {
              "type": "object",
              "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "folderName", "parseRule", "repeatEachAsset", "shuffleWithinBlock"],
          "properties": {
            "mode": { "const": "asset_folder" },
            "folderName": { "$ref": "#/$defs/safePath" },
            "parseRule": { "enum": ["subfolder_as_condition", "filename_prefix", "manual"] },
            "repeatEachAsset": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "shuffleWithinBlock": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    },
    "conditions": {
      "type": "object",
      "required": ["mode", "fields", "rules"],
      "properties": {
        "id": { "type": "string", "maxLength": 200 },
        "name": { "type": "string", "maxLength": 200 },
        "sourceType": { "enum": ["inline", "csv", "factorial"] },
        "mode": { "enum": ["generated", "uploaded_csv", "manual"] },
        "filePath": { "oneOf": [{ "$ref": "#/$defs/safePath" }, { "type": "null" }] },
        "factorialDesign": { "type": ["array", "null"] },
        "fields": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 100 },
              "type": { "enum": ["string", "number", "boolean"] },
              "defaultValue": {},
              "values": { "type": "array" },
              "rules": { "type": "array", "items": { "type": "object" } }
            },
            "additionalProperties": false
          }
        },
        "rules": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": ["id", "type", "params"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 200 },
              "type": { "enum": ["balance", "count", "counterbalance", "compute", "constraint"] },
              "platform": { "enum": ["psychopy", "jspsych", "psychtoolbox"] },
              "expression": { "type": "string", "maxLength": 10000 },
              "transform": { "enum": ["rename", "cast", "map", "compute"] },
              "params": { "type": "object" }
            },
            "additionalProperties": false
          }
        },
        "rows": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "responseRule": {
      "type": "object",
      "required": ["id", "allowedKeys", "correctKeySource", "rtOnset", "responseEvent", "recordRT", "recordAccuracy"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "allowedKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "correctKeySource": { "enum": ["condition_field", "mapping", "fixed", "withhold"] },
        "mappingField": { "type": "string", "maxLength": 200 },
        "correctKeyField": { "type": "string", "maxLength": 200 },
        "mapping": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "correctKey": { "type": "string", "maxLength": 64 },
        "rtOnset": { "type": "string", "minLength": 1, "maxLength": 200 },
        "responseEvent": {
          "enum": ["key_down", "key_release", "click", "submit", "touch", "voice", "gaze_event", "custom"]
        },
        "timeout": { "type": "number", "minimum": 0, "maximum": 3600000 },
        "recordRT": { "type": "boolean" },
        "recordAccuracy": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "dataField": {
      "type": "object",
      "required": ["name", "source", "type", "required"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "source": {
          "enum": ["participant", "condition", "response", "computed", "system", "builtin", "manual"]
        },
        "type": { "enum": ["string", "number", "boolean"] },
        "required": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 2000 },
        "expression": { "type": ["string", "null"], "maxLength": 10000 }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["id", "fileName", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "fileName": { "$ref": "#/$defs/safePath" },
        "type": { "enum": ["image", "sound", "movie", "font", "csv"] },
        "resolvedPath": {
          "oneOf": [{ "$ref": "#/$defs/safePath" }, { "type": "null" }]
        },
        "storageKey": { "type": ["string", "null"], "maxLength": 1000 }
      },
      "additionalProperties": false
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?!/)(?!\\.\\.?(/|$))(?!.*(?:/)\\.\\.?(?:/|$))(?!.*\\\\)[A-Za-z0-9._ -]+(?:/[A-Za-z0-9._ -]+)*$"
    }
  },
  "additionalProperties": false
}
