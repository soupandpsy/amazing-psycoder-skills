{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psycoder.studio/schemas/repair-attempt.schema.json",
  "title": "PsyCoder Constrained Coder Repair Attempt",
  "description": "Current v1.4 internal contract for hash-bound, allowlisted runtime repair proposals after blocking review findings. It cannot mutate ExperimentModel@4, generated metadata, or evidence records. Repair profile 1.0 preserves the frozen shell and every executable reference statement byte-identically and in order; it permits only host-recognized, position-bound additive fail-closed guard blocks at declared reference statements or standalone comments before syntax, hash-rebinding, deterministic validation, and independent rereview gates run.",
  "type": "object",
  "required": [
    "attempt",
    "platform",
    "source_review_id",
    "input_artifact_set_hash",
    "model_hash",
    "asset_set_hash",
    "repair_profile_version",
    "semantic_change",
    "addressed_issue_ids",
    "files",
    "summary"
  ],
  "properties": {
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
    "platform": { "enum": ["psychopy", "jspsych", "psychtoolbox"] },
    "source_review_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "input_artifact_set_hash": { "$ref": "#/$defs/sha256" },
    "model_hash": { "$ref": "#/$defs/sha256" },
    "asset_set_hash": { "$ref": "#/$defs/sha256" },
    "repair_profile_version": { "const": "1.0" },
    "semantic_change": { "const": false },
    "addressed_issue_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["path", "content", "ownership"],
        "properties": {
          "path": { "$ref": "#/$defs/safePath" },
          "content": { "type": "string", "minLength": 1 },
          "ownership": { "const": "model" }
        },
        "additionalProperties": false
      }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?!/)(?!_pipeline(?:/|$))(?!\\.\\.?(/|$))(?!.*(?:/)\\.\\.?(?:/|$))(?!.*\\\\)[A-Za-z0-9._ -]+(?:/[A-Za-z0-9._ -]+)*$"
    }
  },
  "additionalProperties": false
}
